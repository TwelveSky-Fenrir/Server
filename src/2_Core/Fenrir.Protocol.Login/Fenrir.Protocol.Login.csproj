<Project Sdk="Microsoft.NET.Sdk">

  <!-- Paquets du protocole client Login (27 [FenrirPacket]) + leur énumération d'état de session,
       extraits de Fenrir.Application.Login. Un projet-paquets est une FRONTIÈRE DE COMPILATION :
       c'est l'assembly qui déclare les [FenrirPacket] qui décide où les générateurs émettent leurs
       agrégats.

       Namespace PLAT (Fenrir.Protocol.Login, aucun sous-namespace) : le générateur émet dans
       Compilation.AssemblyName, donc ce choix fait qu'un SEUL `using Fenrir.Protocol.Login;` donne
       accès aux paquets ET à LoginOpcodeRegistry / LoginSessionStateGate.

       INVARIANT — aucun type de ce projet ne doit implémenter IAsyncPacketHandler<T> ni
       IInlinePacketHandler<T>. Les 13 handlers Login restent dans Fenrir.Application.Login, seul
       assembly à faire émettre LoginMessageDispatcher / LoginPacketHandlerHub /
       LoginHandlerRegistration. Un handler déposé ici ferait émettre un SECOND jeu d'agrégats de
       dispatch, concurrent du premier : mêmes noms de types, namespaces différents, et le compilateur
       ne signalerait rien tant qu'un site d'appel n'aurait pas les deux `using` en vue. -->

  <!-- LoginSessionState vit ici et NON dans Fenrir.Application.Login : 12 paquets le citent dans leur
       AllowedStates = [(byte)LoginSessionState.X] — sans `using`, par remontée de namespace englobant —
       le laisser derrière créerait un cycle Protocol.Login -> Application.Login -> Protocol.Login. -->

  <ItemGroup>
    <Using Include="Fenrir.Core.Abstractions"/>
    <Using Include="Fenrir.Core.Opcodes"/>
  </ItemGroup>

  <ItemGroup>
    <!-- Ne référence QUE Core : ni Network, ni Data, ni Application. C'est la propriété qui rend ce
         projet réutilisable par n'importe quel assembly parlant le protocole Login sans traîner la
         pile TCP. -->
    <ProjectReference Include="..\Fenrir.Core\Fenrir.Core.csproj"/>
    <ProjectReference Include="..\..\1_Generators\Fenrir.Generators\Fenrir.Generators.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false"/>
  </ItemGroup>

</Project>
