<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.NET.Test.Sdk"/>
    <PackageReference Include="xunit"/>
    <PackageReference Include="xunit.runner.visualstudio">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit"/>
  </ItemGroup>

  <ItemGroup>
    <!-- Fenrir.Tools.DbMigrator is an Exe project (same pattern as Fenrir.LoginServer.Tests ->
         Fenrir.LoginServer); its reader/record types are internal, exposed to this assembly via
         [assembly: InternalsVisibleTo] in Tools/Fenrir.Tools.DbMigrator/AssemblyInfo.cs. -->
    <ProjectReference Include="..\..\Tools\Fenrir.Tools.DbMigrator\Fenrir.Tools.DbMigrator.csproj"/>
  </ItemGroup>

  <ItemGroup>
    <!-- Only the two small static-data files these tests parse (~650 KB total combined), not the whole
         Server/BuildEU33/DATA tree (world maps, etc.); copied next to the test host so
         AppContext.BaseDirectory-relative lookups find them the same way SqlServerFixture finds Database/. -->
    <None Include="..\..\Server\BuildEU33\DATA\005_00002.IMG" CopyToOutputDirectory="PreserveNewest" LinkBase="LegacyData"/>
    <None Include="..\..\Server\BuildEU33\DATA\005_00004.IMG" CopyToOutputDirectory="PreserveNewest" LinkBase="LegacyData"/>
  </ItemGroup>

</Project>
