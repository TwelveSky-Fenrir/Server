<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\..\Infrastructure\Fenrir.Data.Abstractions\Fenrir.Data.Abstractions.csproj"/>
    <!-- WorldDataRepository (concrete) has no interface split reason to hide it — DI registration needs the
         concrete type alongside IWorldDataRepository, same WriteBehind-style exception used elsewhere. -->
    <ProjectReference Include="..\..\Infrastructure\Fenrir.Data\Fenrir.Data.csproj"/>
    <!-- BloodShopBuilder/CashCatalogBuilder produce wire-format catalog snapshots (BloodShop, etc.) from raw
