<Project Sdk="Microsoft.NET.Sdk.Worker">
  <PropertyGroup>
    <FenrirExecutable>true</FenrirExecutable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting"/>
  </ItemGroup>

  <ItemGroup>
    <Content Include="GameData\**\*"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest"/>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Fenrir.Core\Fenrir.Core.csproj"/>
    <ProjectReference Include="..\Fenrir.Domain.Game\Fenrir.Domain.Game.csproj"/>
    <ProjectReference Include="..\Fenrir.Network\Fenrir.Network.csproj"/>
    <ProjectReference Include="..\Fenrir.Data\Fenrir.Data.csproj"/>
    <ProjectReference Include="..\Fenrir.Security\Fenrir.Security.csproj"/>
    <ProjectReference Include="..\Fenrir.Application.Game\Fenrir.Application.Game.csproj"/>
    <ProjectReference Include="..\Fenrir.Application.Game.Handlers\Fenrir.Application.Game.Handlers.csproj"/>
    <ProjectReference Include="..\Fenrir.Application.Game.Services\Fenrir.Application.Game.Services.csproj"/>
    <ProjectReference Include="..\Fenrir.Application.Game.Hosting\Fenrir.Application.Game.Hosting.csproj"/>
    <ProjectReference Include="..\Fenrir.ServiceDefaults\Fenrir.ServiceDefaults.csproj"/>
    <ProjectReference Include="..\Fenrir.Generators\Fenrir.Generators.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false"/>
  </ItemGroup>
</Project>
