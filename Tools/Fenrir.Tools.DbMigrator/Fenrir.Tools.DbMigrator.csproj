<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <FenrirExecutable>true</FenrirExecutable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Infrastructure\Fenrir.Data\Fenrir.Data.csproj"/>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.SqlClient"/>
    <!-- Version managed centrally by Directory.Packages.props (CPM) -->
    <PackageReference Include="CaeriusNet"/>
  </ItemGroup>

  <ItemGroup>
    <!-- Copied next to the exe so the published/AOT binary finds its scripts the same way in dev and deployed
         (Path.Combine(AppContext.BaseDirectory, "Database")); no repo-root-walking heuristics needed. -->
    <None Include="..\..\Database\**\*.*" CopyToOutputDirectory="PreserveNewest" LinkBase="Database"/>
  </ItemGroup>

</Project>
