<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="K4os.Compression.LZ4"/>
  </ItemGroup>

  <ItemGroup>
    <!-- Every packet declaration references Opcodes.* (server/direction constants live in Fenrir.Contracts);
         a project-wide implicit using avoids repeating it in ~300 packet files. -->
    <Using Include="Fenrir.Contracts"/>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Core\Fenrir.Contracts\Fenrir.Contracts.csproj"/>
    <ProjectReference Include="..\Fenrir.Network.Abstractions\Fenrir.Network.Abstractions.csproj"/>
    <!-- Field-level XOR (WireXor.XorInt/XorChar/...) is baked directly into every generated Write(). -->
    <ProjectReference Include="..\Fenrir.Network.Compression\Fenrir.Network.Compression.csproj"/>
  </ItemGroup>

  <ItemGroup>
    <!-- Both must be loaded into the analyzer host: Protocol calls into Analysis at generator
         runtime, and a ProjectReference-as-Analyzer only loads the directly referenced assembly,
         not its own transitive references. -->
    <ProjectReference Include="..\..\Analysis\Fenrir.Generators.Analysis\Fenrir.Generators.Analysis.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false"/>
    <ProjectReference Include="..\..\Generators\Fenrir.Generators.Protocol\Fenrir.Generators.Protocol.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false"/>
  </ItemGroup>

</Project>
