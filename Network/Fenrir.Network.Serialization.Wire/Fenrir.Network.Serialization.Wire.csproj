<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!-- FenrirPacketAttribute/FenrirWireTypeAttribute reference FenrirServer/WireObfuscationMode (living in
         Fenrir.Network.Abstractions); a project-wide implicit using avoids repeating it in every file. -->
    <Using Include="Fenrir.Network.Abstractions"/>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Fenrir.Network.Abstractions\Fenrir.Network.Abstractions.csproj"/>
  </ItemGroup>

</Project>
