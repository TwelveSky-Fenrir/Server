<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <!-- Options/Configuration/DependencyInjection abstractions for DomainServiceCollectionExtensions. -->
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions"/>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Fenrir.Application.Game.GameData\Fenrir.Application.Game.GameData.csproj"/>
    <ProjectReference Include="..\Fenrir.Application.Game.Stats\Fenrir.Application.Game.Stats.csproj"/>
    <ProjectReference Include="..\..\Network\Fenrir.Network.Serialization\Fenrir.Network.Serialization.csproj"/>
    <ProjectReference Include="..\..\Network\Fenrir.Network.Dispatch\Fenrir.Network.Dispatch.csproj"/>
    <ProjectReference Include="..\..\Infrastructure\Fenrir.Data.Abstractions\Fenrir.Data.Abstractions.csproj"/>
    <!-- WriteBehind (DirtyTracker/WriteBehindFlusher) and ApplicationFirewall have no repository interface —
         Domain references the concrete project directly for those, same exception as the pre-split monolith. -->
    <ProjectReference Include="..\..\Infrastructure\Fenrir.Data\Fenrir.Data.csproj"/>
  </ItemGroup>

  <ItemGroup>
    <!-- Repository interfaces + DTOs/TVPs live in Fenrir.Data.Abstractions.* — Domain must only ever reference
         interfaces, never the concrete Fenrir.Data implementation project (WriteBehind/firewall excepted above). -->
    <Using Include="Fenrir.Data.Abstractions.Accounts"/>
    <Using Include="Fenrir.Data.Abstractions.Admin"/>
    <Using Include="Fenrir.Data.Abstractions.Characters"/>
    <Using Include="Fenrir.Data.Abstractions.Commerce"/>
    <Using Include="Fenrir.Data.Abstractions.Guilds"/>
    <Using Include="Fenrir.Data.Abstractions.Progression"/>
    <Using Include="Fenrir.Data.Abstractions.Runtime"/>
    <Using Include="Fenrir.Data.Abstractions.Security"/>
    <Using Include="Fenrir.Data.Abstractions.Social"/>
    <Using Include="Fenrir.Data.Abstractions.Tribes"/>
    <Using Include="Fenrir.Data.Abstractions.World"/>
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
