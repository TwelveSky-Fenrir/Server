<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <!-- Options/DependencyInjection abstractions for DomainServiceCollectionExtensions. -->
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions"/>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Network\Fenrir.Network.Serialization.Wire\Fenrir.Network.Serialization.Wire.csproj"/>
    <ProjectReference Include="..\..\Network\Fenrir.Network.Serialization.Shared\Fenrir.Network.Serialization.Shared.csproj"/>
    <ProjectReference Include="..\..\Network\Fenrir.Network.Serialization.Login\Fenrir.Network.Serialization.Login.csproj"/>
    <ProjectReference Include="..\..\Network\Fenrir.Network.Dispatch\Fenrir.Network.Dispatch.csproj"/>
    <ProjectReference Include="..\..\Infrastructure\Fenrir.Data.Abstractions\Fenrir.Data.Abstractions.csproj"/>
    <!-- ApplicationFirewall has no repository interface — Domain references the concrete project directly for
         it, same exception as the pre-split monolith. -->
    <ProjectReference Include="..\..\Infrastructure\Fenrir.Data\Fenrir.Data.csproj"/>
  </ItemGroup>

  <ItemGroup>
    <Using Include="Fenrir.Data.Abstractions.Accounts"/>
    <Using Include="Fenrir.Data.Abstractions.Admin"/>
    <Using Include="Fenrir.Data.Abstractions.Characters"/>
    <Using Include="Fenrir.Data.Abstractions.Commerce"/>
    <Using Include="Fenrir.Data.Abstractions.Guilds"/>
    <Using Include="Fenrir.Data.Abstractions.Progression"/>
    <Using Include="Fenrir.Data.Abstractions.Runtime"/>
    <Using Include="Fenrir.Data.Abstractions.Security"/>
    <Using Include="Fenrir.Data.Abstractions.Social"/>
    <Using Include="Fenrir.Data.Abstractions.Tribes"/>
    <Using Include="Fenrir.Data.Abstractions.World"/>
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
