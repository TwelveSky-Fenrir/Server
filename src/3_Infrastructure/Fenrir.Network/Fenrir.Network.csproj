<Project Sdk="Microsoft.NET.Sdk">

  <!-- Pile TCP UNIFIÉE (fusion des 11 anciens Network.* — dossiers internes Transport/ Framing/
       Compression/ Dispatch/). Listener/sockets System.IO.Pipelines, framing SANS length-prefix
       (taille par opcode via registre généré), XOR de flux, enveloppe LZ4, boucle de session + routage
       d'opcode (base commune, serveur-agnostique). Dépend de Core, Security, Observability. -->

  <ItemGroup>
    <PackageReference Include="K4os.Compression.LZ4"/>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions"/>
  </ItemGroup>

  <ItemGroup>
    <!-- Les types wire/protocole ont migré en T1 vers Fenrir.Core.* ; global usings pour éviter une
         réécriture par fichier (FenrirServer/WireXor/WireHeaderSizes/WireObfuscationMode/MessageReader/Writer
         → Core.Wire ; IPacketSession/IOutgoingPacket → Core.Abstractions ; Opcodes → Core.Opcodes). Les
         interfaces transport (IFrameDispatcher/IOpcodeFrameSizeProvider) restent en Fenrir.Network.Abstractions. -->
    <Using Include="Fenrir.Core.Wire"/>
    <Using Include="Fenrir.Core.Abstractions"/>
    <Using Include="Fenrir.Core.Opcodes"/>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\2_Core\Fenrir.Core\Fenrir.Core.csproj"/>
    <ProjectReference Include="..\Fenrir.Security\Fenrir.Security.csproj"/>
    <ProjectReference Include="..\Fenrir.Observability\Fenrir.Observability.csproj"/>
  </ItemGroup>

</Project>
