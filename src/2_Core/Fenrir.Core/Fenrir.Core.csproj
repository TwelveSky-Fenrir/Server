<Project Sdk="Microsoft.NET.Sdk">

  <!-- Fenrir.Core = protocole-comme-code, FEUILLE du graphe : ne référence AUCUN autre projet Fenrir.
       Contiendra (Lot F6) : attributs [FenrirPacket]/[FenrirWireType], interfaces paquet/handler à
       membres statiques abstraits, opcodes, MessageReader/MessageWriter, WireHeaderSizes (9 o / 1 o),
       codec XOR legacy, paquets Wire + Shared, et ObfuscatedUidCodec (correctif F11).
       Référence les générateurs en Analyzer car il déclarera des paquets. -->

  <ItemGroup>
    <!-- Les wire-types Shared implémentent IFenrirWireType<T> (Fenrir.Core.Abstractions) — global using
         intra-assembly, écho du <Using Fenrir.Network.Abstractions> de l'ancien Serialization.Shared. -->
    <Using Include="Fenrir.Core.Abstractions"/>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\1_Generators\Fenrir.Generators\Fenrir.Generators.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false"/>
  </ItemGroup>

</Project>
